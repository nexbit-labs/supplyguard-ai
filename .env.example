# Copy to .env (gitignored). Never commit real secrets.
# Every variable read by docker-compose.yml, backend/config/settings.py, mock-erp, frontend.

# --- Django (backend/config/settings.py) ---
DEBUG=True
# Leave EMPTY for local dev: with DEBUG=True an empty value falls back to a dev-only key.
# With DEBUG=False an empty/missing value makes Django refuse to start (on purpose).
# Mandatory for tunnels/hosting. Generate: python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated https origins allowed for CSRF (e.g. https://<tunnel>.trycloudflare.com). Default empty.
CSRF_TRUSTED_ORIGINS=
# True only behind an HTTPS-terminating proxy (Render, tunnel): trusts X-Forwarded-Proto. Keep False locally.
BEHIND_HTTPS_PROXY=False
# Only used when BEHIND_HTTPS_PROXY=True: also makes session/CSRF cookies Secure and sends HSTS for this many seconds. Start low.
SECURE_HSTS_SECONDS=3600
# Render sets RENDER_EXTERNAL_HOSTNAME itself; it is appended to ALLOWED_HOSTS automatically.
LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# --- PostgreSQL 16 (compose db service) ---
POSTGRES_DB=supplyguard
POSTGRES_USER=supplyguard
POSTGRES_PASSWORD=supplyguard
# For running Django outside docker against the compose db (compose builds its own URL):
# DATABASE_URL=postgres://supplyguard:supplyguard@localhost:5432/supplyguard

# --- Host ports (change on clashes) ---
DB_PORT=5432
BACKEND_PORT=8000
MOCK_ERP_PORT=8081
FRONTEND_PORT=5173

# --- Mock ERP (mock-erp/) ---
# Empty = no auth (local only). ALWAYS set a long random value when tunnelled/hosted.
MOCK_ERP_API_KEY=
# Set to false when exposed publicly unless the demo needs reset/chaos endpoints.
MOCK_ERP_ENABLE_TEST_ENDPOINTS=true
MOCK_ERP_CHAOS_DELAY_SECONDS=35
# Only when running mock-erp outside Docker (the image sets it to /srv/data/seed):
# MOCK_ERP_DATA_DIR=./data/seed
# How the backend reaches the mock ERP inside compose (placeholder for later tasks).
MOCK_ERP_URL=http://mock-erp:8081

# --- Frontend (Vite, compose frontend service) ---
# Browser calls the backend directly; default follows BACKEND_PORT.
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# UI runs on its built-in mock API until U-04 (auth) is merged; then set to false
VITE_API_MOCK=true

# --- Tunnel / hosted placeholders (see deploy/README.md; do not commit real values) ---
# MOCK_ERP_PUBLIC_URL=https://<random>.trycloudflare.com
# BACKEND_PUBLIC_URL=https://<random>.trycloudflare.com

# --- Boomi (U-06; real values come from U-08/U-09 and docs/BOOMI_ENV.md) ---
# Empty BOOMI_BASE_URL = not configured: events are stored (publish_status RECEIVED), not sent.
BOOMI_BASE_URL=
# Secret. Never commit a value. With BOOMI_AUTH_MODE=basic this is 'user:password'.
BOOMI_API_KEY=
# apikey = X-Api-Key header (default) | basic = HTTP Basic
BOOMI_AUTH_MODE=apikey
# PLACEHOLDER route until U-08/U-09 define the real one.
BOOMI_EVENT_PATH=/ws/simple/createDisruptionEvent
BOOMI_TIMEOUT_CONNECT=3
BOOMI_TIMEOUT_READ=5
# Retries (on top of the first try) for timeouts, connection errors, 429/502/503/504 only.
BOOMI_MAX_RETRIES=1
# Budget in seconds for ALL attempts + backoffs of one publish (runs inside the intake request).
BOOMI_TOTAL_TIMEOUT_SECONDS=8
# First wait in seconds, doubled for every further retry.
BOOMI_BACKOFF_SECONDS=0.5
# Folder with the demo scenarios. Default <repo>/data/scenarios (/data/scenarios in Docker).
# SCENARIO_DIR=

# --- Execution retries (U-03) ---
# Max user-requested retries of a failed ERP execution (Execution.retryable). Default 3.
EXECUTION_MAX_RETRIES=3

# --- Seed data (U-03: manage.py load_seed) ---
# Folder with the seed JSON files. Default: <repo>/data/seed (set it only to load another set).
# SEED_DATA_DIR=
# Password for the demo users created by `load_seed --demo-users`.
# Only for --demo-users, never commit a value.
DEMO_USER_PASSWORD=

# --- Login throttling (U-04) ---
# Rate for /auth/token and /auth/refresh per client IP. Each gunicorn worker counts separately.
AUTH_THROTTLE_RATE=10/min
# Rate for /auth/token per (lowercased) username, on top of the per-IP rate.
AUTH_USERNAME_THROTTLE_RATE=10/min
# Rate for /auth/refresh per client IP (separate budget from the login).
AUTH_REFRESH_THROTTLE_RATE=60/min
# Number of trusted reverse proxies in front of Django: 0 = none (default), 1 = behind the
# U-12 proxy. Controls how X-Forwarded-For is read for throttles and failed-key counters.
NUM_PROXIES=0
# Failed credentials per client IP per minute: audit rows written at most this often, and
# after AUTH_FAIL_LIMIT_PER_MIN bad API keys the IP gets 429 before the key is even checked.
AUTH_FAIL_AUDIT_PER_MIN=10
AUTH_FAIL_LIMIT_PER_MIN=30


# --- AI output validator (N-07) ---
# Folder with the agent JSON schemas. Set by docker-compose / the Dockerfile; set it only when running outside docker.
# SG_SCHEMA_DIR=/app/ai/schemas

# --- What-if simulator (N-11): ERP read access ---
# ERP_BASE_URL=http://localhost:8081
# ERP_API_KEY=
# ERP_TIMEOUT_SECONDS=2.0

# Total ERP time budget for one what-if (all sequential calls); exceeded -> 504.
# ERP_TOTAL_TIMEOUT_SECONDS=2.5
