{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/gitflow.py local-sync --quiet",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python scripts/progress.py --brief",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/advisor_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python scripts/progress.py:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Bash(git push --force origin main:*)",
      "Bash(git push --force origin collaboration:*)",
      "Bash(git push origin main:*)",
      "Read(./.env)",
      "Read(./**/.env)"
    ]
  },
  "model": "opus",
  "effortLevel": "medium",
  "worktree": {
    "baseRef": "head"
  }
}
